# ============================================================================
# AI TikTok Shop Auto Director — environment configuration
# ============================================================================

# REQUIRED. API key for the AI provider (Anthropic Claude).
# Claude is used because it accepts TEXT + IMAGE in the same request, which
# this app relies on for real product-photo analysis (productVisionAnalyzer)
# and for all creative-direction text generation (autoDirector).
# Get a key at https://console.anthropic.com/settings/keys
AI_API_KEY=

# OPTIONAL. Model id to use. Must be a Claude 3.x/4.x model — those support
# image input. Do NOT point this at a text-only model (e.g. legacy claude-2 /
# claude-instant); the app checks the name and will refuse to start a vision
# call against a model it cannot confirm supports images.
# Default below is a current vision-capable Sonnet model.
AI_MODEL=claude-sonnet-4-5-20250929

# OPTIONAL. Set to "true" to expose the technical debug trace (URL
# accessibility, fetch status, candidate images, vision success/failure
# reasons, etc.) in API responses for local development. Leave unset/false
# in production.
DEBUG_MODE=false
